# --- Database ---
# Local dev (see docker-compose.yml at repo root), or a free Supabase/Neon connection string
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_yt_publisher

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Token encryption (used later, from Phase 3 onward, for storing OAuth tokens) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-me-with-a-fernet-key

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# --- Frontend base URL (used to redirect the browser after Google OAuth) ---
FRONTEND_URL=http://localhost:5173

# --- Google OAuth (YouTube channel connection, Phase 3) ---
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on that OAuth client
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/channels/oauth/callback

# --- Google Drive service account (Phase 2) ---
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# --- AI SEO metadata (Phase 5) ---
AI_PROVIDER=openrouter
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Automation (Phase 7) ---
AUTOMATION_HOUR_UTC=3
AUTOMATION_MINUTE_UTC=0
RETRY_INTERVAL_MINUTES=60
MAX_UPLOAD_RETRIES=3
GEMINI_MODEL=gemini-2.5-flash
# Used only after the primary model exhausts its retries on transient 5xx/503 errors
GEMINI_FALLBACK_MODEL=gemini-flash-latest
AI_REQUEST_TIMEOUT_SECONDS=45
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_DEFAULT_CATEGORY_ID=22
YOUTUBE_UPLOAD_CHUNK_BYTES=8388608

SCHEDULER_TIMEZONE=UTC
OAUTH_STATE_TTL_SECONDS=600
OAUTH_STATE_COOKIE_NAME=yt_oauth_state_binding
OAUTH_STATE_COOKIE_SECURE=false
UPLOAD_STALE_AFTER_MINUTES=30
